# Copy this file to backend/.env and fill it in. Never commit .env.

# Flagsmith: Environment settings > Keys > the SERVER-side key (starts with "ser.")
FLAGSMITH_SERVER_KEY=
# Only for the simulator: the STAGING environment's server-side key
STAGING_SERVER_KEY=

# AI providers, tried in this order. Leave a key empty to skip that provider.
PROVIDER_ORDER=groq,nvidia,gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Copy the exact model IDs from each provider's console; they change over time.

# Storage: leave empty for local SQLite; a Neon or Supabase Postgres URL in production
DATABASE_URL=

# Your deployed frontend's address, e.g. https://tell-or-teach.netlify.app
ALLOWED_ORIGIN=*
